{% extends "base.dtl" %}
{% block title %}asobi_admin - Player {{ player.username }}{% endblock %}
{% block content %}
<p><a href="/admin/ui/players">&larr; Players</a></p>
<h1>{{ player.username }}</h1>
<p class="muted">{{ player.id }} &middot; {% if online %}online{% else %}offline{% endif %}
  {% if player.banned_at %}&middot; <span class="pill pill-banned">banned {{ player.banned_at }}</span>{% endif %}
</p>

<div class="panel">
  <h3>Actions</h3>
  {% if player.banned_at %}
  <form method="post" action="/admin/ui/players/{{ player.id }}/unban" class="inline-form">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}" />
    <button type="submit" class="btn">Unban</button>
  </form>
  {% else %}
  <form method="post" action="/admin/ui/players/{{ player.id }}/ban" class="inline-form">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}" />
    <button type="submit" class="btn btn-danger">Ban</button>
  </form>
  {% endif %}

  <form method="post" action="/admin/ui/players/{{ player.id }}/grant" class="inline-block-form">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}" />
    <input type="text" name="currency" placeholder="gold" class="w-80" />
    <input type="number" name="amount" placeholder="amount" class="w-100" />
    <button type="submit" class="btn">Grant currency</button>
  </form>
</div>

<div class="panel">
  <h3>Wallets</h3>
  <table>
    <thead><tr><th>Currency</th><th>Balance</th></tr></thead>
    <tbody>
      {% for wallet in wallets %}
      <tr><td>{{ wallet.currency }}</td><td>{{ wallet.balance }}</td></tr>
      {% empty %}
      <tr><td colspan="2" class="muted">No wallets.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
