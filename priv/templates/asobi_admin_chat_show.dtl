{% extends "base.dtl" %}
{% block title %}asobi_admin - Chat {{ channel_id }}{% endblock %}
{% block content %}
<p><a href="/admin/ui/chat">&larr; Channels</a></p>
<h1>Channel {{ channel_id }}</h1>

<div class="panel">
  <table>
    <thead><tr><th>Sent</th><th>Player</th><th>Message</th></tr></thead>
    <tbody>
      {% for m in messages %}
      <tr>
        <td class="muted">{{ m.sent_at }}</td>
        <td>{{ m.player_id }}</td>
        <td>{{ m.content }}</td>
      </tr>
      {% empty %}
      <tr><td colspan="3" class="muted">No messages.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
