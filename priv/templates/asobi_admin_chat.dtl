{% extends "base.dtl" %}
{% block title %}asobi_admin - Chat{% endblock %}
{% block content %}
<h1>Chat channels</h1>

<div class="panel">
  <table>
    <thead><tr><th>Channel</th><th>Members</th></tr></thead>
    <tbody>
      {% for c in channels %}
      <tr>
        <td><a href="/admin/ui/chat/{{ c.channel_id }}">{{ c.channel_id }}</a></td>
        <td>{{ c.member_count }}</td>
      </tr>
      {% empty %}
      <tr><td colspan="2" class="muted">No active channels.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
