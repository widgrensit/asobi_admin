[
    {kernel, [
        {logger_level, debug},
        {logger, [
            {handler, default, logger_std_h, #{
                formatter => {nova_jsonlogger, #{
                    map_depth => 3,
                    term_depth => 50
                }}
            }}
        ]}
    ]},
    {nova, [
        {use_stacktrace, true},
        {environment, dev},
        {cowboy_configuration, #{
            port => 8083
        }},
        {dev_mode, true},
        {bootstrap_application, asobi_admin},
        {json_lib, json},
        %% asobi_admin never uses nova_session (the console UI's own
        %% asobi_admin_session + HMAC-derived CSRF cover that); without this,
        %% Nova sets its own `session_id` cookie on every response with no
        %% HttpOnly/Secure/SameSite attributes and no purpose.
        {use_sessions, false}
    ]},
    {asobi_admin, [
        {admin_token, <<"${ASOBI_ADMIN_TOKEN}">>},
        {deployment_mode, <<"${ASOBI_ADMIN_DEPLOYMENT_MODE}">>},
        {session_secret, <<"${ASOBI_ADMIN_SESSION_SECRET}">>},
        {session_ttl_ms, 43_200_000}
    ]},
    {asobi, [
        {asobi_repo, #{
            database => <<"asobi_dev">>,
            hostname => <<"localhost">>,
            port => 5432,
            username => <<"postgres">>,
            password => <<"postgres">>,
            pool_size => 5
        }}
    ]}
].
